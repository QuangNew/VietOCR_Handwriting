[Unit]
Description=VietOCR named Cloudflare connector
After=network-online.target vietocr-gateway.service
Wants=network-online.target
# Retry until Wi-Fi/Internet returns, including outages during boot.
StartLimitIntervalSec=0

[Service]
Type=simple
User=cloudflared
Group=cloudflared
ExecStart=/usr/local/bin/cloudflared --no-autoupdate --config /etc/cloudflared/pi.yml tunnel run
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=4096
TasksMax=64
MemoryHigh=256M
MemoryMax=384M
UMask=0077

[Install]
WantedBy=multi-user.target
