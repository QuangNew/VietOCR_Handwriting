[Unit]
Description=VietOCR Raspberry gateway
After=network-online.target
Wants=network-online.target
# Keep recovering after a long Wi-Fi outage; do not exhaust a short boot window.
StartLimitIntervalSec=0

[Service]
Type=simple
User=vietocr
Group=vietocr
SupplementaryGroups=video spi gpio
WorkingDirectory=/opt/vietocr
ExecStart=/opt/vietocr/vietocr-gateway /etc/vietocr/gateway.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
Environment=RUST_LOG=vietocr_gateway=info
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=4096
TasksMax=96
MemoryHigh=512M
MemoryMax=768M
UMask=0077

[Install]
WantedBy=multi-user.target
