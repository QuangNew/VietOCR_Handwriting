{
  "openapi": "3.1.0",
  "info": {
    "title": "VietHandOCR Client / Raspberry / Compute v2",
    "version": "2.0.0",
    "description": "Implemented v2 API: Google-only Raspberry camera/admission/streaming upload, compute durable images, direct job-scoped results. Metadata history excludes OCR text and image data."
  },
  "servers": [
    {
      "url": "https://api.quangnew.tech"
    }
  ],
  "security": [
    {
      "googleSession": []
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "gatewayLiveness",
        "x-implementation": "implemented",
        "security": [],
        "responses": {
          "200": {
            "description": "Process alive; does not assert database, camera or OCR readiness"
          }
        }
      }
    },
    "/api/v2/session": {
      "get": {
        "operationId": "verifyGoogleSession",
        "x-implementation": "implemented",
        "description": "Locally verify Supabase ES256 signature/claims, then verify Google provider/current session/ban in Postgres. No OCR quota charge.",
        "responses": {
          "200": {
            "description": "Account identity, effective 500/30-or-lower policy, camera catalog and explicit ocrAvailable readiness"
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        }
      }
    },
    "/api/v2/cameras": {
      "get": {
        "operationId": "listPiCameras",
        "x-implementation": "implemented",
        "responses": {
          "200": {
            "description": "Configured Pi webcams; actual current JPEG dimensions, freshness, consumer count and error when available. No camera opened merely by listing."
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        }
      }
    },
    "/api/v2/cameras/{cameraId}/stream": {
      "parameters": [
        {
          "name": "cameraId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,48}$"
          }
        }
      ],
      "get": {
        "operationId": "watchPiCamera",
        "x-implementation": "implemented",
        "description": "Bearer header required (no URL tokens). Native JPEG parts with Content-Length; latest-frame buffer, bounded viewers, independent capture producer. Revalidate current Google session every 15 seconds; reconnect on JWT/session expiry or maximum 600-second stream lifetime. Slow viewers skip frames. No OCR charge.",
        "responses": {
          "200": {
            "description": "MJPEG multipart stream, boundary=vietocr, no-store. First frame and disconnect are separate from HTTP header success.",
            "content": {
              "multipart/x-mixed-replace": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        }
      }
    },
    "/api/v2/cameras/{cameraId}/snapshots": {
      "parameters": [
        {
          "name": "cameraId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "capturePiDraft",
        "x-implementation": "implemented",
        "description": "Wait for a new native JPEG after the capture request. Return the exact frame at the UVC stream resolution, never the UI thumbnail. Client stores a private draft. Does not create an intent, upload to compute, run OCR or consume OCR quota. Bounded capture rate/concurrency applies separately.",
        "responses": {
          "200": {
            "description": "Original compressed JPEG; next action is client draft/edit, not automatic OCR",
            "headers": {
              "X-Image-Sha256": {
                "schema": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "X-Image-Width": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "X-Image-Height": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "X-Captured-Unix-Ms": {
                "description": "Time frame reached the gateway; not a hardware exposure timestamp",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        }
      }
    },
    "/api/v2/server/status": {
      "get": {
        "operationId": "viewServerStatus",
        "x-implementation": "implemented",
        "responses": {
          "200": {
            "description": "Latest server stats or explicit offline/stale error, alarm state and pulse sequence. No OCR/account data.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "server": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/ServerStats"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "alarmActive": {
                      "type": "boolean"
                    },
                    "buzzerSequence": {
                      "type": "integer"
                    },
                    "error": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        }
      }
    },
    "/api/internal/v2/status": {
      "servers": [
        {
          "url": "https://ocr.quangnew.tech"
        }
      ],
      "get": {
        "operationId": "sampleComputeLoad",
        "x-implementation": "implemented",
        "security": [
          {
            "telemetryMachine": []
          }
        ],
        "responses": {
          "200": {
            "description": "Small cached host statistics; no GPU enumeration, database round trip or result content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerStats"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        }
      }
    },
    "/api/v2/intents": {
      "post": {
        "operationId": "createOcrIntent",
        "x-implementation": "implemented",
        "description": "Explicit Send metadata only; requestId account-idempotent; no OCR charge until validated full acceptance.",
        "responses": {
          "200": {
            "description": "Operation result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntentState"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImageIntent"
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listOwnedIntents",
        "x-implementation": "implemented",
        "description": "Latest 100 intent metadata rows of this account, newest first. Fields from database use snake_case (created_at, accepted_at); image bytes and OCR text are excluded.",
        "responses": {
          "200": {
            "description": "Operation result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "state",
                      "created_at"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "state": {
                        "$ref": "#/components/schemas/JobState"
                      },
                      "created_at": {
                        "type": "string",
                        "format": "date-time"
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        }
      }
    },
    "/api/v2/intents/{jobId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/JobId"
        }
      ],
      "get": {
        "operationId": "readIntent",
        "x-implementation": "implemented",
        "description": "Owner-only metadata/state; Google bearer required.",
        "responses": {
          "200": {
            "description": "Operation result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntentState"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        }
      }
    },
    "/api/v2/intents/{jobId}/grant": {
      "parameters": [
        {
          "$ref": "#/components/parameters/JobId"
        }
      ],
      "post": {
        "operationId": "grantUpload",
        "x-implementation": "implemented",
        "description": "Fair active demand, server worker/capacity authority,500/30 holds and120s fenced lease.",
        "responses": {
          "200": {
            "description": "Operation result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Grant"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Command"
              }
            }
          }
        }
      }
    },
    "/api/v2/intents/{jobId}/content": {
      "parameters": [
        {
          "$ref": "#/components/parameters/JobId"
        }
      ],
      "put": {
        "operationId": "uploadChunk",
        "x-implementation": "implemented",
        "description": "Raw1..1048576bytes; Content-Length, Upload-Offset and X-OCR-Generation required. Pi streams to disk on compute.",
        "responses": {
          "200": {
            "description": "Operation result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "offset"
                  ],
                  "properties": {
                    "offset": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        },
        "parameters": [
          {
            "name": "Content-Length",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            }
          },
          {
            "name": "Upload-Offset",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "X-OCR-Generation",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      }
    },
    "/api/v2/intents/{jobId}/complete": {
      "parameters": [
        {
          "$ref": "#/components/parameters/JobId"
        }
      ],
      "post": {
        "operationId": "completeImage",
        "x-implementation": "implemented",
        "description": "JSON generation. Verify hash/type/pixels, fsync image/receipt, commit quota exactly once and enqueue.",
        "responses": {
          "200": {
            "description": "Operation result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "accepted",
                    "jobId"
                  ],
                  "properties": {
                    "accepted": {
                      "const": true
                    },
                    "jobId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteCommand"
              }
            }
          }
        }
      }
    },
    "/api/v2/intents/{jobId}/result-ticket": {
      "parameters": [
        {
          "$ref": "#/components/parameters/JobId"
        }
      ],
      "post": {
        "operationId": "mintResultTicket",
        "x-implementation": "implemented",
        "description": "Five-minute job/user/session-scoped read ticket and pinned compute URL.",
        "responses": {
          "200": {
            "description": "Operation result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultTicket"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Command"
              }
            }
          }
        }
      }
    },
    "/api/v2/intents/{jobId}/cancel": {
      "parameters": [
        {
          "$ref": "#/components/parameters/JobId"
        }
      ],
      "delete": {
        "operationId": "cancelIntent",
        "x-implementation": "implemented",
        "description": "Cancel a pre-acceptance intent or its queued/running compute job through Raspberry. The current Google session/owner is revalidated. Accepted images retain their quota; a job that already finished keeps its actual terminal state.",
        "responses": {
          "200": {
            "description": "Operation result"
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Command"
              }
            }
          }
        }
      }
    },
    "/api/v2/results/{jobId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/JobId"
        }
      ],
      "get": {
        "operationId": "readComputeResult",
        "x-implementation": "implemented",
        "description": "On https://ocr.quangnew.tech. Authorization Bearer result ticket, optional wait0..10s. Read-only owner/session/ban checks; no create/upload.",
        "responses": {
          "200": {
            "description": "Operation result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          },
          "410": {
            "description": "result_expired: accepted result was removed by retention. The response never pretends the image still needs upload."
          }
        },
        "security": [
          {
            "resultTicket": []
          }
        ],
        "parameters": [
          {
            "name": "wait",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10,
              "default": 0
            }
          }
        ]
      },
      "servers": [
        {
          "url": "https://ocr.quangnew.tech"
        }
      ]
    }
  },
  "components": {
    "securitySchemes": {
      "googleSession": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Supabase ES256 JWT; current Google session also verified in DB"
      },
      "resultTicket": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Short-lived scoped result JWT, not a Google access token"
      },
      "telemetryMachine": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Random Pi machine credential; server stores SHA-256; read-only telemetry scope"
      }
    },
    "parameters": {
      "JobId": {
        "name": "jobId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "Failure": {
        "description": "401 invalid/expired session; 403 banned/revoked; 409 conflict/stale lease; 429 quota/capacity; 503 dependency offline. Retry-After where retryable. Never includes secrets or photo/OCR content. 410 expired intent/result; 413 body too large; 422 invalid image; 507 spool capacity.",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "retryAfterSeconds": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        }
      },
      "JobState": {
        "type": "string",
        "enum": [
          "awaiting_upload",
          "upload_granted",
          "uploading",
          "queued",
          "running",
          "succeeded",
          "failed",
          "cancelled"
        ]
      },
      "ImageIntent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "sha256",
          "imageBytes",
          "mediaType",
          "layout",
          "imageVersion"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "imageBytes": {
            "type": "integer",
            "minimum": 16,
            "maximum": 67108864
          },
          "mediaType": {
            "type": "string",
            "enum": [
              "image/jpeg",
              "image/png",
              "image/webp"
            ]
          },
          "layout": {
            "type": "string",
            "enum": [
              "auto",
              "line"
            ]
          },
          "imageVersion": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "AccountLimits": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dailyImages",
          "requestsPerMinute"
        ],
        "properties": {
          "dailyImages": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 500
          },
          "requestsPerMinute": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "default": 30
          }
        }
      },
      "ServerStats": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "serverId",
          "sampledAtUnixMs",
          "uptimeSeconds",
          "ready",
          "cpuPercent",
          "ramUsedPercent",
          "idleWorkers",
          "busyWorkers",
          "startingWorkers",
          "drainingWorkers",
          "queuedJobs"
        ],
        "properties": {
          "serverId": {
            "type": "string",
            "maxLength": 80
          },
          "sampledAtUnixMs": {
            "type": "integer",
            "minimum": 0
          },
          "uptimeSeconds": {
            "type": "number",
            "minimum": 0
          },
          "ready": {
            "type": "boolean"
          },
          "cpuPercent": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "ramUsedPercent": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "idleWorkers": {
            "type": "integer",
            "minimum": 0
          },
          "busyWorkers": {
            "type": "integer",
            "minimum": 0
          },
          "startingWorkers": {
            "type": "integer",
            "minimum": 0
          },
          "drainingWorkers": {
            "type": "integer",
            "minimum": 0
          },
          "queuedJobs": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Command": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "generation": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          }
        }
      },
      "CompleteCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "generation"
        ],
        "properties": {
          "generation": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "IntentState": {
        "type": "object",
        "required": [
          "id",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "$ref": "#/components/schemas/JobState"
          },
          "generation": {
            "type": "integer",
            "minimum": 0
          },
          "layout": {
            "type": "string",
            "enum": [
              "auto",
              "line"
            ]
          }
        }
      },
      "Grant": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "accepted",
              "id"
            ],
            "properties": {
              "accepted": {
                "const": true
              },
              "id": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "generation",
              "offset",
              "expiresAt",
              "chunkBytes"
            ],
            "properties": {
              "generation": {
                "type": "integer",
                "minimum": 1
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time"
              },
              "chunkBytes": {
                "const": 1048576
              }
            }
          }
        ]
      },
      "ResultTicket": {
        "type": "object",
        "required": [
          "jobId",
          "resultUrl",
          "ticket",
          "expiresIn"
        ],
        "properties": {
          "jobId": {
            "type": "string",
            "format": "uuid"
          },
          "resultUrl": {
            "type": "string",
            "format": "uri"
          },
          "ticket": {
            "type": "string",
            "readOnly": true
          },
          "expiresIn": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300
          }
        }
      },
      "Result": {
        "type": "object",
        "required": [
          "id",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "$ref": "#/components/schemas/JobState"
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "width": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "height": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "queueMs": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "inferenceMs": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "totalMs": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    }
  }
}
